data
logs
artifacts
!artifacts/benchmarks.json
!artifacts/p3_full
!artifacts/p3_ffpp
!artifacts/p4
!artifacts/p6
!artifacts/p6v2

# Local scratch.
*.log
.DS_Store
docs
memory
